# URL do backend (Spring Boot): de onde vêm o catálogo, os pedidos e o conteúdo da loja.
# Em desenvolvimento, suba o backend antes (porta 8080). Em produção, a URL do Cloud Run.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Login de cliente com Google (Supabase Auth). Sem estas duas, a loja funciona sem a opção de entrar.
# Supabase → Project Settings → API Keys: a chave pública ("anon" / "publishable"), nunca a secreta.
# NEXT_PUBLIC_SUPABASE_URL=https://trlsbiybhtmykxmznkcn.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
