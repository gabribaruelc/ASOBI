# Copie para backend/.env (já está no .gitignore) e preencha.
# Rodar contra o Supabase: SPRING_PROFILES_ACTIVE=local,supabase
# Formato .properties: se a senha tiver "\", escreva "\\".

# Supabase → botão "Connect" → aba "Connection string" → "Session pooler".
# Copie só o host (aws-...pooler.supabase.com) para dentro da URL abaixo.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.trlsbiybhtmykxmznkcn
DB_PASSWORD=

# Fotos de produto no Supabase Storage. Sem estas duas, as fotos vão para backend/data/uploads.
# A chave é a secreta (Project Settings → API Keys → service_role / sb_secret_...), nunca a "anon".
# SUPABASE_URL=https://trlsbiybhtmykxmznkcn.supabase.co
# SUPABASE_SERVICE_KEY=

# E-mails de pedido pelo Resend. Sem a chave, os e-mails só aparecem no log.
# RESEND_API_KEY=
# EMAIL_FROM=ASOBI <pedidos@asobi.com.br>
# EMAIL_REPLY_TO=

# Primeiro admin, criado só se a tabela admin_users estiver vazia.
# Use a conta Google que vai entrar no painel em produção (sem ela, fica priscila@asobi.com.br).
# ADMIN_BOOTSTRAP_EMAIL=voce@gmail.com
