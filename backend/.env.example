# Copie para backend/.env (já está no .gitignore) e preencha.
# Rodar contra o Supabase: SPRING_PROFILES_ACTIVE=local,supabase
# Formato .properties: se a senha tiver "\", escreva "\\".

# Supabase → botão "Connect" → aba "Connection string" → "Session pooler".
# Copie só o host (aws-...pooler.supabase.com) para dentro da URL abaixo.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.trlsbiybhtmykxmznkcn
DB_PASSWORD=

# Fotos de produto no Supabase Storage. Sem estas duas, as fotos vão para backend/data/uploads.
# A chave é a secreta (Project Settings → API Keys → service_role / sb_secret_...), nunca a "anon".
# SUPABASE_URL=https://trlsbiybhtmykxmznkcn.supabase.co
# SUPABASE_SERVICE_KEY=

# E-mails de pedido pelo Resend. Sem a chave, os e-mails só aparecem no log.
# RESEND_API_KEY=
# EMAIL_FROM=ASOBI <pedidos@asobi.com.br>
# EMAIL_REPLY_TO=

# Lista de admins: fica no admin-auth-service (../admin-auth-service), que precisa estar
# rodando para entrar no painel. Localmente o backend já procura em http://localhost:8083.
# ADMIN_AUTH_SERVICE_URL=http://localhost:8083
# ADMIN_AUTH_SERVICE_API_KEY=
# Para rodar só o backend, deixe a URL vazia (ADMIN_AUTH_SERVICE_URL=): a lista fica em
# memória, só com o e-mail abaixo, e o que for adicionado pelo painel some ao reiniciar.
# ADMIN_BOOTSTRAP_EMAIL=voce@gmail.com

# Código por e-mail depois do login do painel (../two-factor-service). Sem a URL, o painel
# pede só o login. Localmente o código aparece no log do two-factor-service.
# TWO_FACTOR_SERVICE_URL=http://localhost:8082
# TWO_FACTOR_SERVICE_API_KEY=

# Avisos de "entrou em promoção" e "voltou ao estoque" (../notification-service). Sem a URL,
# a loja não mostra o "avise-me" na ficha do jogo.
# NOTIFICATION_SERVICE_URL=http://localhost:8084
# NOTIFICATION_SERVICE_API_KEY=
