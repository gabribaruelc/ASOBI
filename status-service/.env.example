# Copie para status-service/.env (já está no .gitignore) e preencha.
# Sem este arquivo o serviço roda com H2 local (data/status), confere os serviços em localhost
# e escreve os avisos no log.
# Rodar contra o Supabase: SPRING_PROFILES_ACTIVE=supabase
# Formato .properties: se a senha tiver "\", escreva "\\".

# Mesmo host do backend (Supabase → "Connect" → "Session pooler"), mas com o usuário
# próprio deste serviço, criado pelo SQL de docs/status-service.md: status_service.<id-do-projeto>
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=status_service.<id-do-projeto>
DB_PASSWORD=

# Chave que a rotina do Cloud Scheduler manda em X-Api-Key. Vazia = sem conferência (só local).
# STATUS_SERVICE_API_KEY=

# De onde vem a lista de admins (mesma chave do backend/.env).
# ADMIN_AUTH_SERVICE_URL=http://localhost:8083
# ADMIN_AUTH_SERVICE_API_KEY=

# Para quem avisar se a lista de admins nunca pôde ser lida (separados por vírgula).
# STATUS_FALLBACK_EMAILS=admin@asobi.com.br

# Endereços conferidos. Vazio = fica de fora.
# STORE_URL=http://localhost:3000
# BACKEND_URL=http://localhost:8080
# SHIPPING_SERVICE_URL=http://localhost:8081
# TWO_FACTOR_SERVICE_URL=http://localhost:8082
# NOTIFICATION_SERVICE_URL=http://localhost:8084

# Resend. Sem a chave, o aviso só aparece no log.
# RESEND_API_KEY=
# EMAIL_FROM=ASOBI <avisos@asobi.com.br>
