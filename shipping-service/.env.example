# Copie para shipping-service/.env (já está no .gitignore) e preencha.

# A mesma chave que o backend manda em X-Api-Key. Vazia = sem conferência (só local).
# SHIPPING_SERVICE_API_KEY=

# Melhor Envio → Integrações → Tokens de acesso (permissão shipping-calculate).
# O token do sandbox (sandbox.melhorenvio.com.br) só vale com MELHOR_ENVIO_SANDBOX=true.
# MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_SANDBOX=true
# MELHOR_ENVIO_CONTACT_EMAIL=contato@asobi.com.br
